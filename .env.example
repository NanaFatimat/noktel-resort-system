# ==== FIREBASE CONFIGURATION (Public) ====
# Required for connecting to Firebase services from the frontend.
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_firebase_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_firebase_measurement_id"

# ==== CLOUDINARY CONFIGURATION (Public) ====
# Required for free image hosting via direct browser uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_cloudinary_upload_preset"

# ==== GEMINI AI CONFIGURATION (Public) ====
# Required for the AI Voice Assistant functionality
NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key"

# ==== STRIPE CONFIGURATION ====
# Required for the payment gateway.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..." # Keep this secret! Only use in Node/Server environments. Never prefix with NEXT_PUBLIC_

# ==== RESEND CONFIGURATION ====
# Required for sending confirmation emails
RESEND_API_KEY="re_..."
